// thirdbase Projektstyring — datamodel
// Postgres via DATABASE_URL. Alle handlinger i appen persisteres her.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime bruger den poolede forbindelse; migrationer kører mod den direkte.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  image              String?
  initials           String
  color              String   @default("#3355FF")
  role               String   @default("Medarbejder")
  emailNotifications Boolean  @default(true)
  invitedAt          DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime @default(now())

  assignedTasks       Task[]         @relation("TaskAssignees")
  comments            Comment[]
  mentionedIn         Comment[]      @relation("CommentMentions")
  activities          Activity[]
  notifications       Notification[]
  createdCustomers    Customer[]     @relation("CustomerCreator")
  createdBoards       Board[]        @relation("BoardCreator")
  createdTasks        Task[]         @relation("TaskCreator")
  uploadedAttachments Attachment[]   @relation("AttachmentUploader")
  ansvarligProjekter  ClientProject[] @relation("ProjektAnsvarlig")
  godkendteBaser      ProjectBase[]   @relation("BaseGodkender")
  afkrydsedePunkter   ChecklistItem[] @relation("ChecklistAfkrydser")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  short     String
  industry  String
  color     String   @default("#3355FF")
  position  Int      @default(0)
  creatorId String?
  createdAt DateTime @default(now())

  creator User?   @relation("CustomerCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  boards  Board[]
  clientProjects ClientProject[]
}

model Board {
  id         String @id @default(cuid())
  name       String
  position   Int    @default(0)
  customerId String
  creatorId  String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  creator  User?    @relation("BoardCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  groups   Group[]

  @@index([customerId])
}

model Group {
  id       String @id @default(cuid())
  name     String
  color    String
  position Int    @default(0)
  boardId  String

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId])
}

model Task {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("Ikke startet")
  priority  String   @default("Medium")
  startDate String? // 'YYYY-MM-DD'
  endDate   String? // 'YYYY-MM-DD'
  notes     String   @default("")
  position  Int      @default(0)
  groupId   String
  creatorId String?
  createdAt DateTime @default(now())

  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator       User?          @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  assignees     User[]         @relation("TaskAssignees")
  subtasks      Subtask[]
  comments      Comment[]
  activities    Activity[]
  files         Attachment[]
  notifications Notification[]

  @@index([groupId])
  @@index([endDate])
  @@index([status])
}

model Subtask {
  id       String  @id @default(cuid())
  name     String
  done     Boolean @default(false)
  position Int     @default(0)
  taskId   String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Comment {
  id          String   @id @default(cuid())
  body        String
  displayTime String? // menneskeligt tidsstempel fra seed ("i går kl. 14.22")
  createdAt   DateTime @default(now())
  taskId      String
  authorId    String?
  authorName  String? // historisk navn — bevares når forfatteren slettes

  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author   User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  mentions User[] @relation("CommentMentions")

  @@index([taskId])
  @@index([authorId])
}

model Attachment {
  id           String   @id @default(cuid())
  name         String
  type         String
  meta         String
  taskId       String
  data         Bytes? // selve filens bytes — hentes ALDRIG i loadAppData
  size         Int? // bytes; null = gammel attrap-række uden fil
  mime         String?
  uploadedById String?
  uploaderName String? // historisk navn — bevares når uploaderen slettes
  createdAt    DateTime @default(now())

  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User? @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([taskId])
}

model Activity {
  id          String   @id @default(cuid())
  text        String
  color       String
  displayTime String?
  createdAt   DateTime @default(now())
  taskId      String
  actorId     String?

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId])
}

model Notification {
  id        String   @id @default(cuid())
  text      String
  time      String
  color     String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  taskId    String?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([taskId])
}

// ==================================================================
// The Thirdbase Model — kundeprojekt ud fra fast skabelon.
// Rent additivt. Alle fremmednøgler ligger på de nye tabeller; de
// eksisterende tabeller får ingen nye kolonner.
// ==================================================================

model ClientProject {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sektion 0 · Projektstamdata
  kundeNavn            String
  cvr                  String?
  kontaktpersonNavn    String?
  kontaktpersonTitel   String?
  kontaktpersonMail    String?
  kontaktpersonTelefon String?
  deltagere            String?
  projektstart         String? // 'YYYY-MM-DD'
  forventetAfslutning  String? // 'YYYY-MM-DD'
  nuvaerendeBase       String  @default("1") // 1, 2, 3 eller Home
  samletStatus         String  @default("Ikke startet")
  kadence              String?
  hubspotPortal        String?
  projektmappe         String?

  // Formål og forventet resultat
  formaal String?

  // Kundens udgangspunkt
  udgangspunktKanaler        String?
  udgangspunktLeadsPrMaaned  String?
  udgangspunktSalgsproces    String?
  udgangspunktCrmModenhed    String?
  udgangspunktAutomatisering String?
  udgangspunktHvorTabes      String?

  // Vigtigste fund fra afdækningen
  vigtigsteFund String?

  customerId         String?
  projektansvarligId String?
  opretterId         String?

  customer         Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  projektansvarlig User?     @relation("ProjektAnsvarlig", fields: [projektansvarligId], references: [id], onDelete: SetNull)

  baser        ProjectBase[]
  afdaekning   DiscoveryActivity[]
  risici       ProjectRisk[]
  beslutninger ProjectDecision[]
  aendringer   ChangeLogEntry[]
  moeder       StatusMeeting[]
  ejerskab     OwnershipArea[]
  reviews      PerformanceReview[]

  @@index([customerId])
  @@index([projektansvarligId])
}

model ProjectBase {
  id             String  @id @default(cuid())
  nummer         Int // 1, 2, 3 eller 4 (Home)
  navn           String
  status         String  @default("Ikke startet")
  ansvarlig      String?
  startdato      String? // 'YYYY-MM-DD'
  maaldato       String? // 'YYYY-MM-DD'
  godkendtDato   String? // 'YYYY-MM-DD'
  godkendtAfId   String?
  godkendtAfNavn String? // historisk navn, bevares hvis brugeren slettes
  projectId      String

  project    ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  godkendtAf User?         @relation("BaseGodkender", fields: [godkendtAfId], references: [id], onDelete: SetNull)

  steps            BaseStep[]
  tjekliste        ChecklistItem[]
  kpier            Kpi[]
  kanaler          MarketingChannel[]
  faser            PipelineStage[]
  scoringRegler    LeadScoringRule[]
  automatiseringer Automation[]

  @@unique([projectId, nummer])
  @@index([projectId])
}

model BaseStep {
  id          String  @id @default(cuid())
  kode        String // fx "1.1"
  titel       String
  beskrivelse String  @default("")
  aktiviteter String? // konkrete aktiviteter for denne kunde
  ejer        String?
  deadline    String? // 'YYYY-MM-DD'
  status      String  @default("Ikke startet")
  position    Int     @default(0)
  baseId      String

  base ProjectBase @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@index([baseId])
}

model ChecklistItem {
  id              String    @id @default(cuid())
  tekst           String
  afkrydset       Boolean   @default(false)
  afkrydsetDato   DateTime?
  afkrydsetAfId   String?
  afkrydsetAfNavn String?
  position        Int       @default(0)
  baseId          String

  base        ProjectBase @relation(fields: [baseId], references: [id], onDelete: Cascade)
  afkrydsetAf User?       @relation("ChecklistAfkrydser", fields: [afkrydsetAfId], references: [id], onDelete: SetNull)

  @@index([baseId])
}

model Kpi {
  id          String  @id @default(cuid())
  navn        String
  beskrivelse String  @default("")
  baseline    String?
  maal        String?
  aktuel      String?
  maaledato   String? // 'YYYY-MM-DD'
  kilde       String?
  position    Int     @default(0)
  baseId      String

  base ProjectBase @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@index([baseId])
}

model DiscoveryActivity {
  id        String  @id @default(cuid())
  kode      String // A1 til A6
  aktivitet String
  ejer      String?
  deadline  String? // 'YYYY-MM-DD'
  status    String  @default("Ikke startet")
  noter     String?
  position  Int     @default(0)
  projectId String

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model MarketingChannel {
  id           String  @id @default(cuid())
  kanal        String
  aktiv        Boolean @default(false)
  budget       String?
  landingsside String?
  sporingSatOp Boolean @default(false)
  ansvarlig    String?
  position     Int     @default(0)
  baseId       String

  base ProjectBase @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@index([baseId])
}

model PipelineStage {
  id             String  @id @default(cuid())
  trin           Int
  fase           String
  kriterie       String?
  ejer           String?
  automatisering String?
  baseId         String

  base ProjectBase @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@index([baseId])
}

model LeadScoringRule {
  id       String  @id @default(cuid())
  kriterie String  @default("")
  type     String // Adfærd eller Profil
  point    String?
  note     String?
  position Int     @default(0)
  baseId   String

  base ProjectBase @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@index([baseId])
}

model Automation {
  id        String  @id @default(cuid())
  navn      String  @default("")
  trigger   String?
  handling  String?
  vaerktoej String?
  status    String  @default("Ikke startet")
  ejer      String?
  position  Int     @default(0)
  baseId    String

  base ProjectBase @relation(fields: [baseId], references: [id], onDelete: Cascade)

  @@index([baseId])
}

model OwnershipArea {
  id               String  @id @default(cuid())
  omraade          String
  ejerHosKunden    String?
  ejerHosThirdbase String?
  gennemgang       String?
  position         Int     @default(0)
  projectId        String

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ChangeLogEntry {
  id              String   @id @default(cuid())
  version         String
  dato            String? // 'YYYY-MM-DD'
  hvadBlevAendret String   @default("")
  hvorfor         String?
  aendretAf       String?
  resultat        String?
  createdAt       DateTime @default(now())
  projectId       String

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model PerformanceReview {
  id                     String   @id @default(cuid())
  dato                   String? // 'YYYY-MM-DD'
  deltagere              String?
  vigtigsteFund          String?
  besluttedeOptimeringer String?
  naesteReview           String? // 'YYYY-MM-DD'
  createdAt              DateTime @default(now())
  projectId              String

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectRisk {
  id          String   @id @default(cuid())
  kode        String // R1, R2 ...
  beskrivelse String   @default("")
  base        String?
  konsekvens  String?
  haandtering String?
  ejer        String?
  status      String   @default("Åben")
  createdAt   DateTime @default(now())
  projectId   String

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectDecision {
  id          String   @id @default(cuid())
  dato        String? // 'YYYY-MM-DD'
  beslutning  String   @default("")
  baggrund    String?
  besluttetAf String?
  createdAt   DateTime @default(now())
  projectId   String

  project ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model StatusMeeting {
  id             String   @id @default(cuid())
  dato           String? // 'YYYY-MM-DD'
  deltagere      String?
  nuvaerendeBase String?
  sidenSidst     String?
  kpiBevaegelse  String?
  blokeringer    String?
  beslutninger   String?
  naesteMoede    String? // 'YYYY-MM-DD'
  createdAt      DateTime @default(now())
  projectId      String

  project ClientProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skridt  StatusMeetingAction[]

  @@index([projectId])
}

model StatusMeetingAction {
  id        String  @id @default(cuid())
  opgave    String  @default("")
  ejer      String?
  deadline  String? // 'YYYY-MM-DD'
  position  Int     @default(0)
  meetingId String

  meeting StatusMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
}
