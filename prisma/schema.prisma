// thirdbase Projektstyring — datamodel
// Postgres via DATABASE_URL. Alle handlinger i appen persisteres her.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime bruger den poolede forbindelse; migrationer kører mod den direkte.
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  name               String
  image              String?
  initials           String
  color              String   @default("#3355FF")
  role               String   @default("Medarbejder")
  emailNotifications Boolean  @default(true)
  invitedAt          DateTime?
  lastLoginAt        DateTime?
  createdAt          DateTime @default(now())

  assignedTasks       Task[]         @relation("TaskAssignees")
  comments            Comment[]
  mentionedIn         Comment[]      @relation("CommentMentions")
  activities          Activity[]
  notifications       Notification[]
  createdCustomers    Customer[]     @relation("CustomerCreator")
  createdBoards       Board[]        @relation("BoardCreator")
  createdTasks        Task[]         @relation("TaskCreator")
  uploadedAttachments Attachment[]   @relation("AttachmentUploader")
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  short     String
  industry  String
  color     String   @default("#3355FF")
  position  Int      @default(0)
  creatorId String?
  createdAt DateTime @default(now())

  creator User?   @relation("CustomerCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  boards  Board[]
}

model Board {
  id         String @id @default(cuid())
  name       String
  position   Int    @default(0)
  customerId String
  creatorId  String?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  creator  User?    @relation("BoardCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  groups   Group[]

  @@index([customerId])
}

model Group {
  id       String @id @default(cuid())
  name     String
  color    String
  position Int    @default(0)
  boardId  String

  board Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([boardId])
}

model Task {
  id        String   @id @default(cuid())
  name      String
  status    String   @default("Ikke startet")
  priority  String   @default("Medium")
  startDate String? // 'YYYY-MM-DD'
  endDate   String? // 'YYYY-MM-DD'
  notes     String   @default("")
  position  Int      @default(0)
  groupId   String
  creatorId String?
  createdAt DateTime @default(now())

  group         Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator       User?          @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  assignees     User[]         @relation("TaskAssignees")
  subtasks      Subtask[]
  comments      Comment[]
  activities    Activity[]
  files         Attachment[]
  notifications Notification[]

  @@index([groupId])
  @@index([endDate])
  @@index([status])
}

model Subtask {
  id       String  @id @default(cuid())
  name     String
  done     Boolean @default(false)
  position Int     @default(0)
  taskId   String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Comment {
  id          String   @id @default(cuid())
  body        String
  displayTime String? // menneskeligt tidsstempel fra seed ("i går kl. 14.22")
  createdAt   DateTime @default(now())
  taskId      String
  authorId    String?
  authorName  String? // historisk navn — bevares når forfatteren slettes

  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author   User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)
  mentions User[] @relation("CommentMentions")

  @@index([taskId])
  @@index([authorId])
}

model Attachment {
  id           String   @id @default(cuid())
  name         String
  type         String
  meta         String
  taskId       String
  data         Bytes? // selve filens bytes — hentes ALDRIG i loadAppData
  size         Int? // bytes; null = gammel attrap-række uden fil
  mime         String?
  uploadedById String?
  uploaderName String? // historisk navn — bevares når uploaderen slettes
  createdAt    DateTime @default(now())

  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader User? @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([taskId])
}

model Activity {
  id          String   @id @default(cuid())
  text        String
  color       String
  displayTime String?
  createdAt   DateTime @default(now())
  taskId      String
  actorId     String?

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([taskId])
}

model Notification {
  id        String   @id @default(cuid())
  text      String
  time      String
  color     String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String
  taskId    String?

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([taskId])
}
