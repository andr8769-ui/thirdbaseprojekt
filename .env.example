# ------------------------------------------------------------------
# thirdbase Projektstyring — miljøvariabler
# Kopiér denne fil til .env og udfyld værdierne. Commit ALDRIG .env.
# ------------------------------------------------------------------

# Google OAuth (Google Cloud Console → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=din-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dit-google-client-secret

# Auth.js / NextAuth v5
# Generér en hemmelighed med:  npx auth secret   (eller: openssl rand -base64 32)
AUTH_SECRET=en-lang-tilfaeldig-streng

# Canonisk URL for appen. Lokalt: http://localhost:3000
# På Vercel sættes denne til produktions-URL'en, fx https://projekt.thirdbase.dk
AUTH_URL=http://localhost:3000

# Komma-separeret liste af mails der automatisk får rollen Admin (må slette alt).
# Sættes ved login og backfilles ved hvert build.
ADMIN_EMAILS=andreas@thirdbase.dk

# Postgres-forbindelse (fx Neon, Vercel Postgres eller Supabase).
# DATABASE_URL: POOLED connection string — bruges af appen i runtime.
DATABASE_URL=postgresql://bruger:password@host-pooler:5432/thirdbase?schema=public
# DATABASE_URL_UNPOOLED: DIRECT connection string — bruges af Prisma til
# migrationer (directUrl i schema.prisma). Neon leverer begge automatisk.
# Lokalt uden pooler kan den sættes til samme værdi som DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://bruger:password@host:5432/thirdbase?schema=public

# ------------------------------------------------------------------
# E-mail-notifikationer (valgfrit). Vælg ÉN backend:
#   1) Resend (foretrukket) — sæt RESEND_API_KEY.
#   2) SMTP via nodemailer — sæt SMTP_HOST/PORT/USER/PASS.
# Er ingen sat, sendes der ingen mails (in-app-notifikationer virker stadig).
# ------------------------------------------------------------------
RESEND_API_KEY=

# Gmail / Google Workspace-opsætning:
#   - Slå 2-trinsbekræftelse til på kontoen (myaccount.google.com/security).
#   - Opret et app-password (myaccount.google.com/apppasswords) og brug det som SMTP_PASS.
#   - Port 465 = secure (implicit TLS).
#   - Gmail overskriver afsenderen hvis From ikke matcher SMTP_USER — appen bruger derfor
#     automatisk SMTP_USER som afsenderadresse og beholder visningsnavnet fra EMAIL_FROM.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=andreas@thirdbase.dk
SMTP_PASS=

# Afsender på notifikations-mails (visningsnavn + adresse).
EMAIL_FROM=thirdbase Projektstyring <andreas@thirdbase.dk>
